<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>BackgroundJobs</PackageId>
    <RootNamespace>BackgroundJobs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- No ASP.NET Core: HTTP lives in BackgroundJobs.AspNetCore and BackgroundJobs.Dashboard. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Storage/Postgres/Migrations/*.sql" />
  </ItemGroup>
</Project>
